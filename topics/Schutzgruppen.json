    {
      "heading": "Bn – Anbringung",
      "question": "Wie wird eine Benzyl-Schutzgruppe angebracht?",
      "answer": [
        {
          "type": "latex",
          "content": "\\mathrm{R-OH \\xrightarrow[Base]{BnBr} R-O-Bn}"
        },
        {
          "type": "markdown",
          "content": "Typisch: **BnBr + NaH** oder eine andere geeignete Base."
        }
      ]
    },
    {
      "heading": "Bn – Abspaltung",
      "question": "Wie wird eine Benzyl-Schutzgruppe abgespalten?",
      "answer": [
        {
          "type": "latex",
          "content": "\\mathrm{R-O-Bn \\xrightarrow{H_2,\\ Pd/C} R-OH}"
        },
        {
          "type": "text",
          "content": "Hydrogenolyse."
        }
      ]
